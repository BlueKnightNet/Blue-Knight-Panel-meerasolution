# Meera's observed template copies the whole build directory, then start:prod.
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY . .
RUN npm run build

FROM node:20-alpine
WORKDIR /app
COPY --from=builder /app /app
# Deliberately do not inject PORT: the production launcher must default to 3000.
CMD ["npm", "run", "start:prod"]
