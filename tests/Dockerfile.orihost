# Exercise Pterodactyl's writable /home/container layout and allocated port.
FROM node:22-bookworm-slim
RUN mkdir -p /home/container && chown node:node /home/container
WORKDIR /home/container
USER node
COPY --chown=node:node package*.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY --chown=node:node index.js orihost.cjs ./
# A conflicting generic PORT must not override the assigned SERVER_PORT.
ENV SERVER_PORT=3000 PORT=8080
CMD ["npm", "run", "start:orihost"]
